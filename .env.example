# -------------------------
# 1. PUBLIC - Frontend (NEXT_PUBLIC_)
# User er browser e jabe, tai safe key
# -------------------------
NEXT_PUBLIC_APP_URL="https://krishilink-jstu.vercel.app"
NEXT_PUBLIC_SUPABASE_URL="https://dsyltmuidosjtkfvzvch.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY_HERE_REPLACE_IN_VERCEL"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE"

# -------------------------
# 2. PRIVATE - Backend (Server Only)
# Kokhono browser e jabe na
# -------------------------

# Auth - 32+ char random string
NEXTAUTH_URL="https://krishilink-jstu.vercel.app"
NEXTAUTH_SECRET="YOUR_32_PLUS_CHAR_RANDOM_SECRET_GENERATE_WITH_openssl_rand_base64_32"

# Database - Supabase Pooler
# Format: postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.dsyltmuidosjtkfvzvch:YOUR_DB_PASSWORD_HERE@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dsyltmuidosjtkfvzvch:YOUR_DB_PASSWORD_HERE@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Secret - ONLY in Vercel, NEVER in GitHub
SUPABASE_SERVICE_ROLE_KEY="sb_secret_YOUR_SERVICE_ROLE_SECRET_KEY_HERE_REPLACE_IN_VERCEL"

# Payment Gateway
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY_HERE"
BKASH_APP_KEY="YOUR_BKASH_APP_KEY"
BKASH_APP_SECRET="YOUR_BKASH_APP_SECRET"
BKASH_USERNAME="YOUR_BKASH_USERNAME"
BKASH_PASSWORD="YOUR_BKASH_PASSWORD"
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

# Real-time & AI - Optional
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_KEY="YOUR_PUSHER_KEY"
PUSHER_SECRET="YOUR_PUSHER_SECRET"
PUSHER_CLUSTER="ap1"
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
